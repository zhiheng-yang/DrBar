root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xcstrings}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Info.plist,*.entitlements}]
indent_style = tab

[*.applescript]
indent_style = tab
